# Copy this file to .env and paste your key. .env is git-ignored and never uploaded.
# Never put a key in chat, code, or a screenshot.

# --- Groq ---
BASE_URL=https://api.groq.com/openai/v1
API_KEY=paste_your_groq_key_here
# MODEL is pinned for the batch: the instructor changes it, not you.
# (No comment after a value on the same line: some editors read the whole line as the value.)
MODEL=openai/gpt-oss-20b

# --- Ollama fallback (local, private). Uncomment these three, comment the three above. ---
# BASE_URL=http://localhost:11434/v1
# API_KEY=ollama
# MODEL=llama3.2:3b

# --- Gemini ---
# Free key: aistudio.google.com -> Get API key. No card needed.
GEMINI_API_KEY=paste_your_gemini_key_here
# Leave blank to auto-detect the current Flash model; or pin one after running
# list_gemini_models() in landscape notebook.
GEMINI_MODEL=

# --- Vision model. Leave blank to auto-detect what your provider offers. ---
VISION_MODEL=
